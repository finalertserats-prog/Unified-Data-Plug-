#!/usr/bin/env bash
set -euo pipefail

if docker compose version >/dev/null 2>&1; then
  COMPOSE="docker compose"
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE="docker-compose"
else
  COMPOSE=""
fi

cmd="${1:-help}"

case "$cmd" in
  doctor)
    bash scripts/doctor.sh
    ;;
  start)
    [ -n "$COMPOSE" ] || { echo "Docker Compose not found"; exit 1; }
    $COMPOSE up -d
    ;;
  stop)
    [ -n "$COMPOSE" ] || { echo "Docker Compose not found"; exit 1; }
    $COMPOSE down
    ;;
  restart)
    [ -n "$COMPOSE" ] || { echo "Docker Compose not found"; exit 1; }
    $COMPOSE down
    $COMPOSE up -d
    ;;
  bootstrap)
    bash scripts/bootstrap.sh
    ;;
  smoke-test)
    bash scripts/smoke-test.sh
    ;;
  status)
    [ -n "$COMPOSE" ] || { echo "Docker Compose not found"; exit 1; }
    $COMPOSE ps
    ;;
  logs)
    [ -n "$COMPOSE" ] || { echo "Docker Compose not found"; exit 1; }
    $COMPOSE logs -f "${2:-}"
    ;;
  clean)
    [ -n "$COMPOSE" ] || { echo "Docker Compose not found"; exit 1; }
    $COMPOSE --profile ranger down -v
    ;;
  ranger)
    [ -n "$COMPOSE" ] || { echo "Docker Compose not found"; exit 1; }
    sub="${2:-up}"
    case "$sub" in
      up)
        echo "Starting Ranger admin (first run builds image, ~10 min)..."
        $COMPOSE --profile ranger up -d --build ranger-postgres ranger-admin
        echo "Ranger admin: http://localhost:6080 (default user: admin)"
        ;;
      down)
        $COMPOSE --profile ranger stop ranger-admin ranger-postgres
        ;;
      logs)
        $COMPOSE --profile ranger logs -f ranger-admin
        ;;
      *)
        echo "Usage: ./udp ranger [up|down|logs]"
        exit 1
        ;;
    esac
    ;;
  help|*)
    cat <<'EOF'
Unified Data Plug CLI

Commands:
  ./udp doctor          Check host requirements
  ./udp start           Start core UDP stack (MinIO, HMS, Spark, StarRocks)
  ./udp stop            Stop UDP stack
  ./udp restart         Restart UDP stack
  ./udp bootstrap       Create demo raw, curated, and app analytics layer
  ./udp smoke-test      Validate end-to-end lakehouse readiness
  ./udp ranger up       Start optional Apache Ranger admin (governance plane)
  ./udp ranger down     Stop Ranger admin
  ./udp status          Show container status
  ./udp logs            Tail logs
  ./udp clean           Stop and remove volumes (including Ranger)
EOF
    ;;
esac
