#!/usr/bin/env bash
# Day-to-day UDP CLI. Works in both modes (native systemd / Docker compose).
set -euo pipefail

UDP_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$UDP_HOME"

# Mode detection: native if systemd unit udp-minio exists, else docker
detect_mode() {
  if systemctl list-unit-files 2>/dev/null | grep -q '^udp-minio.service'; then
    echo native
  elif command -v docker >/dev/null 2>&1; then
    echo docker
  else
    echo unknown
  fi
}

MODE="${UDP_MODE:-$(detect_mode)}"

# Compose CLI helper
compose_cli() {
  if docker compose version >/dev/null 2>&1; then
    docker compose "$@"
  elif command -v docker-compose >/dev/null 2>&1; then
    docker-compose "$@"
  else
    echo "Docker Compose not found"; exit 1
  fi
}

NATIVE_UNITS=(udp-minio udp-hive-metastore udp-starrocks-fe udp-starrocks-be)

cmd="${1:-help}"

case "$cmd" in
  doctor)
    bash scripts/doctor.sh
    ;;
  start)
    case "$MODE" in
      native) systemctl start "${NATIVE_UNITS[@]}" ;;
      docker) compose_cli up -d ;;
      *) echo "No install detected. Run: bash install.sh"; exit 1 ;;
    esac
    ;;
  stop)
    case "$MODE" in
      native) systemctl stop "${NATIVE_UNITS[@]}" ;;
      docker) compose_cli down ;;
    esac
    ;;
  restart)
    case "$MODE" in
      native) systemctl restart "${NATIVE_UNITS[@]}" ;;
      docker) compose_cli down && compose_cli up -d ;;
    esac
    ;;
  status)
    case "$MODE" in
      native) systemctl status "${NATIVE_UNITS[@]}" --no-pager ;;
      docker) compose_cli ps ;;
    esac
    ;;
  logs)
    case "$MODE" in
      native) journalctl -fu "udp-${2:-minio}" ;;
      docker) compose_cli logs -f "${2:-}" ;;
    esac
    ;;
  bootstrap)
    case "$MODE" in
      native) bash scripts/native/08_bootstrap.sh ;;
      docker) bash scripts/bootstrap.sh ;;
    esac
    ;;
  smoke-test)
    bash scripts/smoke-test.sh
    ;;
  ranger)
    if [ "$MODE" != "docker" ]; then
      echo "Ranger admin currently runs only in docker mode. Run: bash install.sh --mode=docker"
      exit 1
    fi
    sub="${2:-up}"
    case "$sub" in
      up)   compose_cli --profile ranger up -d --build ranger-postgres ranger-admin ;;
      down) compose_cli --profile ranger stop ranger-admin ranger-postgres ;;
      logs) compose_cli --profile ranger logs -f ranger-admin ;;
      *) echo "Usage: ./udp ranger [up|down|logs]"; exit 1 ;;
    esac
    ;;
  clean)
    case "$MODE" in
      native)
        systemctl stop "${NATIVE_UNITS[@]}" 2>/dev/null || true
        for u in "${NATIVE_UNITS[@]}"; do systemctl disable "$u" 2>/dev/null || true; done
        echo "Stopped and disabled native units. Data preserved in /var/lib/udp."
        ;;
      docker)
        compose_cli --profile ranger down -v
        ;;
    esac
    ;;
  mode)
    echo "$MODE"
    ;;
  help|*)
    cat <<EOF
Unified Data Plug CLI (mode: ${MODE})

Commands:
  ./udp doctor          Check host requirements
  ./udp start           Start core UDP stack
  ./udp stop            Stop UDP stack
  ./udp restart         Restart UDP stack
  ./udp bootstrap       Create demo raw, curated, and app analytics layer
  ./udp smoke-test      Validate end-to-end lakehouse readiness
  ./udp ranger up       Start optional Apache Ranger admin (docker mode only)
  ./udp status          Show service / container status
  ./udp logs [name]     Tail logs
  ./udp clean           Stop services (and remove volumes in docker mode)
  ./udp mode            Print the detected install mode (native|docker)

Override mode: UDP_MODE=native ./udp status
EOF
    ;;
esac
