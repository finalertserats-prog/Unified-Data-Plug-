#!/usr/bin/env bash
set -euo pipefail

if docker compose version >/dev/null 2>&1; then
  COMPOSE="docker compose"
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE="docker-compose"
else
  COMPOSE=""
fi

cmd="${1:-help}"

case "$cmd" in
  doctor)
    bash scripts/doctor.sh
    ;;
  start)
    [ -n "$COMPOSE" ] || { echo "Docker Compose not found"; exit 1; }
    $COMPOSE up -d
    ;;
  stop)
    [ -n "$COMPOSE" ] || { echo "Docker Compose not found"; exit 1; }
    $COMPOSE down
    ;;
  restart)
    [ -n "$COMPOSE" ] || { echo "Docker Compose not found"; exit 1; }
    $COMPOSE down
    $COMPOSE up -d
    ;;
  bootstrap)
    bash scripts/bootstrap.sh
    ;;
  smoke-test)
    bash scripts/smoke-test.sh
    ;;
  status)
    [ -n "$COMPOSE" ] || { echo "Docker Compose not found"; exit 1; }
    $COMPOSE ps
    ;;
  logs)
    [ -n "$COMPOSE" ] || { echo "Docker Compose not found"; exit 1; }
    $COMPOSE logs -f "${2:-}"
    ;;
  backup)
    bash scripts/backup.sh "${2:-}"
    ;;
  restore)
    [ -n "${2:-}" ] || { echo "Usage: ./udp restore <backup-dir>"; exit 1; }
    bash scripts/restore.sh "$2"
    ;;
  clean)
    [ -n "$COMPOSE" ] || { echo "Docker Compose not found"; exit 1; }
    force="${2:-}"
    if [ "$force" != "--yes" ] && [ "$force" != "-y" ]; then
      echo "DANGER: 'udp clean' removes ALL volumes — Iceberg metadata, MinIO objects,"
      echo "        StarRocks tables, demo data — with no backup."
      echo ""
      read -r -p "Type 'wipe' to confirm: " confirm || true
      if [ "$confirm" != "wipe" ]; then
        echo "Aborted."
        exit 1
      fi
    fi
    $COMPOSE down -v
    ;;
  help|*)
    cat <<'EOF'
Unified Data Plug CLI

Commands:
  ./udp doctor       Check host requirements
  ./udp start        Start UDP stack
  ./udp stop         Stop UDP stack
  ./udp restart      Restart UDP stack
  ./udp bootstrap    Create demo raw, curated, and app analytics layer
  ./udp smoke-test   Validate end-to-end lakehouse readiness
  ./udp status       Show container status
  ./udp logs         Tail logs
  ./udp backup       Snapshot Postgres + MinIO + StarRocks FE metadata
  ./udp restore <d>  Restore from a backup directory
  ./udp clean        Stop and remove volumes (DESTRUCTIVE — prompts for 'wipe')
  ./udp clean --yes  Same, no prompt (use only in scripts)
EOF
    ;;
esac
