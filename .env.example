UDP_PROJECT_NAME=unified-data-plug
UDP_ENV=local

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=udp_admin_12345
MINIO_BUCKET=datalake

AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=udp_admin_12345
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
ICEBERG_WAREHOUSE=s3a://datalake/warehouse

# Hive Metastore (Iceberg catalog backend, default `udp` catalog in Spark)
HMS_URI=thrift://hive-metastore:9083
HMS_DB_NAME=metastore
HMS_DB_USER=hive
HMS_DB_PASSWORD=hive

# Iceberg REST catalog (secondary `udp_rest` catalog in Spark)
ICEBERG_REST_URI=http://iceberg-rest:8181

# StarRocks
STARROCKS_HOST=127.0.0.1
STARROCKS_MYSQL_PORT=9030
STARROCKS_ROOT_PASSWORD=

# Apache Ranger (optional, enable with: ./udp ranger up)
RANGER_DB_NAME=ranger
RANGER_DB_USER=ranger
RANGER_DB_PASSWORD=ranger
RANGER_ADMIN_PASSWORD=udp_admin_12345
