# Reference values only. NEVER commit a real .env.
# `bash install.sh` generates a real .env with random credentials and chmod 600.
# If you build .env by hand, replace every CHANGE_ME_* below with a strong random value.

UDP_PROJECT_NAME=unified-data-plug
UDP_ENV=local

MINIO_ROOT_USER=udp_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATE_VIA_INSTALL_SH
MINIO_BUCKET=datalake

AWS_ACCESS_KEY_ID=udp_admin
AWS_SECRET_ACCESS_KEY=CHANGE_ME_GENERATE_VIA_INSTALL_SH
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
ICEBERG_WAREHOUSE=s3://datalake/warehouse
ICEBERG_REST_URI=http://iceberg-rest:8181

STARROCKS_HOST=127.0.0.1
STARROCKS_MYSQL_PORT=9030
STARROCKS_ROOT_PASSWORD=CHANGE_ME_GENERATE_VIA_INSTALL_SH

POSTGRES_USER=iceberg
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_VIA_INSTALL_SH
POSTGRES_DB=iceberg_catalog

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GENERATE_VIA_INSTALL_SH

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_GENERATE_VIA_INSTALL_SH
AIRFLOW_ADMIN_EMAIL=admin@udp.local
AIRFLOW_DB=airflow_meta
AIRFLOW_FERNET_KEY=CHANGE_ME_GENERATE_VIA_INSTALL_SH
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME_GENERATE_VIA_INSTALL_SH

DAGSTER_DB=dagster_meta

# Customization choices. Allowed: airflow | dagster | none
UDP_ORCHESTRATOR=airflow
