[Unit]
Description=UDP StarRocks Frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=udp
Group=udp
EnvironmentFile=/etc/udp/udp.env
Environment=JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
WorkingDirectory=/opt/udp/starrocks/fe
ExecStart=/opt/udp/starrocks/fe/bin/start_fe.sh --daemon
ExecStop=/opt/udp/starrocks/fe/bin/stop_fe.sh
Restart=on-failure
RestartSec=10
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
