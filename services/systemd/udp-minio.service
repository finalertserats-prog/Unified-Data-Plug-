[Unit]
Description=UDP MinIO object storage
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=udp
Group=udp
EnvironmentFile=/etc/udp/udp.env
Environment=MINIO_VOLUMES=/var/lib/udp/minio
Environment=MINIO_OPTS=--console-address :9001
ExecStart=/opt/udp/minio/bin/minio server $MINIO_VOLUMES $MINIO_OPTS
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
